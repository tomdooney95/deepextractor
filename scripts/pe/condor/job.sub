Universe   = vanilla
# Required by this schedd's LDG accounting policy (SCHEDD:2:Invalid value
# for search tag: None without it). Trying the detchar/glitchpe tag first;
# swap if the schedd rejects it as an unrecognized group.
accounting_group = ligo.dev.o5.detchar.glitchpe.lalinference
accounting_group_user = tom.dooney
Executable = /home/tom.dooney/.conda/envs/deepextractor/bin/python
# initialdir = scripts/pe/ (one level up from this condor/ dir) -- run.py
# opens './aLIGO_O4_high_asd.txt' relative to the process CWD, and that file
# only exists in scripts/pe/, not scripts/pe/condor/. This also matches the
# README's own manual-invocation convention (cd scripts/pe && python run.py).
initialdir = ..
# This schedd has SUBMIT_ALLOW_GETENV = false (blocks `getenv = true`
# outright), so pass through only what's actually needed instead: HOME
# (matplotlib/bilby cache dirs) and PATH, plus the precautionary MKL fix --
# system Intel oneAPI MKL (2026.0) can shadow the conda env's own bundled
# MKL (2023.1.0) via LD_LIBRARY_PATH on CIT and segfault inside
# libmkl_intel_lp64.so (root-caused via dmesg while debugging
# evaluate_pe_cases_real.py); run.py doesn't touch gengli/torch, but it's
# heavy numpy/scipy (bilby + dynesty), so prepend the env's own lib dir
# rather than find out hours into a nested-sampling run.
environment = "HOME=$ENV(HOME) PATH=$ENV(PATH) LD_LIBRARY_PATH=/home/tom.dooney/.conda/envs/deepextractor/lib:$ENV(LD_LIBRARY_PATH)"
arguments = run.py --seed $(seed) --label $(label) --type $(type) --injection-label $(injection_label) --injection-file $(injection_file) --outdir $(outdir)
# Paths below resolve relative to initialdir (scripts/pe/), hence condor/logs/.
Log = condor/logs/$(label).log
Error = condor/logs/$(label).err
Output = condor/logs/$(label).out
request_memory = 8GB
# run.py hardcodes npool=32 in bilby.run_sampler -- match it so the sampler
# actually gets the parallelism it's configured to use.
request_cpus = 32
request_disk = 8GB
Queue 1
