Universe   = vanilla
# Required by this schedd's LDG accounting policy (SCHEDD:2:Invalid value
# for search tag: None without it).
accounting_group = ligo.dev.o5.detchar.glitchpe.lalinference
accounting_group_user = tom.dooney

# cluster.ldas.cit's execute pool does NOT NFS-mount /home (confirmed: a
# TARGET.UidDomain == MY.UidDomain requirements test matched 0 of 3383
# slots across 2300 machines -- not a small excludable subset, this is how
# the whole pool works). The IGWN-standard answer is CVMFS, which *is*
# mounted pool-wide, plus HTCondor's own file-transfer for everything else
# (same pattern as a colleague's working container-universe submit file:
# relative Log/Output/Error nested inside a transferred outdir, small
# inputs listed explicitly, nothing assumed to exist on a shared filesystem
# at the execute side). run.py only needs plain bilby/dynesty/numpy/
# matplotlib -- no custom deepextractor/gengli/torch code -- so the
# generic CVMFS IGWN stack covers it without needing a custom container
# image. Confirmed present: igwn-py311 has bilby 2.6.0, dynesty 2.1.5.
# Executable is bash, not python directly: python (and anything it
# imports -- matplotlib, and critically arviz, pulled in by corner via
# result.plot_corner() at the very end of run.py) needs a writable HOME.
# $ENV(HOME) (tried previously) resolves at SUBMIT time on ldas-pcdev2,
# producing /home/tom.dooney -- a path that doesn't exist on the execute
# side, and HOME inherited that way crashed the FIRST sanity-check run
# with a PermissionError in arviz's cache-dir mkdir, DESPITE nested
# sampling itself having already completed successfully (6h+ of real
# compute, thrown away by DAGMan's retry since the process still exited
# nonzero). Only a real shell on the execute side can resolve the
# sandbox's own (always-writable) path at runtime, hence the wrapper.
Executable = /bin/bash
transfer_executable = false

# Only used to resolve the relative transfer_input_files paths below at
# SUBMIT time (ldas-pcdev2 does have /home) -- irrelevant to the execute
# side, which runs entirely out of its own sandbox regardless.
initialdir = ..

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files    = run.py, utils.py, aLIGO_O4_high_asd.txt, $(injection_file_src)
transfer_output_files   = $(outdir)

arguments = "-c 'export HOME=$PWD && exec /cvmfs/software.igwn.org/conda/envs/igwn-py311/bin/python run.py --seed $(seed) --label $(label) --type $(type) --injection-label $(injection_label) --injection-file $(injection_file_name) --outdir $(outdir)'"

# Relative, nested inside the transferred outdir -- NOT absolute /home
# paths. Absolute paths were the earlier failure mode: HTCondor tried to
# open them directly on the execute node's (nonexistent) /home mount.
Log    = $(outdir)/condor.log
Output = $(outdir)/condor.out
Error  = $(outdir)/condor.err

request_memory = 8GB
# run.py hardcodes npool=32 in bilby.run_sampler -- match it so the sampler
# actually gets the parallelism it's configured to use.
request_cpus = 32
request_disk = 8GB
Queue 1
